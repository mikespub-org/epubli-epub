{
    "name": "epubli/epub",
    "type": "library",
    "description": "A PHP library for reading and manipulating contents and metadata of EPUB files.",
    "keywords": [
        "EPUB",
        "PHP",
        "metadata"
    ],
    "homepage": "https://github.com/epubli/epub",
    "license": "MIT",
    "authors": [
        {
            "name": "Andreas Gohr",
            "email": "andi@splitbrain.org"
        },
        {
            "name": "Simon Schrape",
            "email": "simon@epubli.com"
        },
        {
            "name": "Epubli Developers",
            "email": "devs@epubli.com"
        },
        {
            "name": "mikespub",
            "homepage": "https://github.com/mikespub-org/epubli-epub",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-zip": "*",
        "mikespub/epubli-common": "^1.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Epubli\\Epub\\": "src/"
        }
    }
}
